# Database (Supabase via MCP)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Service (Requesty.ai gateway - OpenRouter-compatible)
OPENROUTER_API_KEY=your_requesty_api_key_here
OPENROUTER_BASE_URL=https://router.requesty.ai/v1
AI_MODEL=google/gemini-2.0-flash-001

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000/api

# Security
JWT_SECRET=your_jwt_secret_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_32_chars_here

# Cost & Performance Limits
MONTHLY_BUDGET_USD=50
MAX_MESSAGES_PER_HOUR=10000
AI_CONFIDENCE_THRESHOLD=70

# Embedding Rescue (semantic pre-filter)
# Rescues keyword-rejected messages using embedding similarity
EMBEDDING_RESCUE=true
EMBEDDING_RESCUE_THRESHOLD=0.35
EMBEDDING_MODEL=openai/text-embedding-3-small

# Category Classifier (niche lead categorization for contractor bot)
CATEGORY_API_KEY=rqsty-sk-your-separate-key-here
CATEGORY_AI_MODEL=google/gemini-2.0-flash-001
CATEGORY_CLASSIFIER_BATCH_INTERVAL=10000
CATEGORY_CLASSIFIER_BATCH_SIZE=5

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=optional_sentry_dsn_here

# Site Information (for OpenRouter)
YOUR_SITE_URL=http://localhost:3000
YOUR_SITE_NAME=Telegram Lead Analyzer
