# Single-app image: builds the React/Vite frontend and serves it from the Node
# backend (Express) so one deployment runs both the UI and the API.
# Build context = repo root (see docker-compose.yml `api` service).

# ── Stage 1: build the React/Vite frontend ──
# Same build as the standalone frontend Dockerfile, but the SPA points at a
# RELATIVE /api base because the API is now same-origin.
FROM node:22-alpine AS frontend
WORKDIR /fe
COPY package*.json ./
RUN npm ci
COPY . .
ENV VITE_API_URL=/api
RUN npm run build
# → /fe/dist

# ── Stage 2: Node backend that also serves the built SPA ──
# Mirrors backend/backend/Dockerfile, plus copies the compiled frontend to ./public.
FROM node:20-alpine
WORKDIR /app
COPY backend/backend/package*.json ./
RUN npm install --production
COPY backend/backend/ ./
RUN rm -rf ./public
COPY --from=frontend /fe/dist ./public

# Sessions dir (parity with the original backend image)
RUN mkdir -p /tmp/sessions && chmod 777 /tmp/sessions

EXPOSE 3000
ENV NODE_ENV=production
CMD ["node", "--import", "./src/tracing.js", "src/index.js"]
