# Node dependencies (top-level AND nested — the fullstack build pulls backend/ too,
# so host (Windows) node_modules must never leak into the alpine image)
node_modules
**/node_modules

# Stale embedded frontend copy (root src/ is the canonical/deployed one)
backend/backend/frontend

# Git metadata
.git
.gitignore

# Logs and temporary files
logs
*.log
*.tmp
*.temp

# Tests and local scripts not required in the container
.tests
coverage
*.spec.js
*.test.js

# Documentation and local configs
*.md
.env*
frontend
Dockerfile.frontend

# Editor and OS files
.vscode
.idea
.DS_Store
Thumbs.db
